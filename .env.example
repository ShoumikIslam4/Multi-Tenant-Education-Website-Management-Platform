# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Port for the Node/Express server (default: 3000)
PORT="3000"

# MongoDB Atlas connection string (optional - in-memory fallback included for preview)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/schoolos?retryWrites=true&w=majority"

# JWT secret key for signing session tokens
JWT_SECRET="your-256-bit-secret-key-here"

# Node environment
NODE_ENV="development"
